<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<!-- Root: StackPane so the event overlay can sit above everything -->
<?import javafx.scene.control.ProgressIndicator?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="it.polimi.it.view.gui.controllers.GameBoardView"
           prefWidth="1280" prefHeight="800"
           style="-fx-background-color: #0a0805;">

    <!-- Background image -->
    <ImageView preserveRatio="false" fitWidth="1280" fitHeight="800"
               opacity="1.0" mouseTransparent="true" smooth="false">
        <image><Image url="@/it/polimi/it/view/gui/mesos_sfondo.png"/></image>
    </ImageView>

    <BorderPane fx:id="root" styleClass="game-root">

        <!-- HEADER -->
        <top>
            <HBox spacing="20" alignment="CENTER_LEFT" styleClass="game-header">
                <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
                <Label text="MESOS" styleClass="game-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="roundLabel" text="Round —" styleClass="game-header-label"/>
                <Label fx:id="eraLabel"   text="Era I"   styleClass="game-header-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="bannerLabel" text="" styleClass="game-banner"/>
            </HBox>
        </top>

        <!-- CENTER: board a tutta larghezza, log toggle -->
        <center>
            <StackPane>
                <VBox spacing="8" styleClass="board-pane" alignment="CENTER">
                    <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>

                    <Label text="Riga superiore" styleClass="row-title"/>
                    <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                                fitToHeight="true" fitToWidth="true"
                                styleClass="row-scroll" prefHeight="170" minHeight="170">
                        <HBox fx:id="topRowBox" spacing="8" alignment="CENTER" styleClass="card-row"/>
                    </ScrollPane>

                    <Label text="Tessere offerta" styleClass="row-title"/>
                    <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                                fitToHeight="true" fitToWidth="true"
                                styleClass="row-scroll" prefHeight="155" minHeight="155">
                        <HBox spacing="10" alignment="CENTER" styleClass="offer-track-container">
                            <HBox fx:id="turnOrderBox"  spacing="6" alignment="CENTER"       styleClass="turn-order-box"/>
                            <HBox fx:id="offerTrackBox" spacing="10" alignment="CENTER"      styleClass="tile-row"/>
                            <HBox fx:id="deckBox"       spacing="6"  alignment="CENTER_RIGHT" styleClass="deck-box"/>
                        </HBox>
                    </ScrollPane>

                    <Label text="Riga inferiore" styleClass="row-title"/>
                    <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                                fitToHeight="true" fitToWidth="true"
                                styleClass="row-scroll" prefHeight="170" minHeight="170">
                        <HBox fx:id="bottomRowBox" spacing="8" alignment="CENTER" styleClass="card-row"/>
                    </ScrollPane>

                    <HBox fx:id="actionBar" spacing="10" alignment="CENTER_RIGHT" styleClass="action-bar">
                        <Button fx:id="passButton"    text="Passa"   onAction="#onPass"    visible="false" managed="false"/>
                        <Button fx:id="declineButton" text="Rifiuta" onAction="#onDecline" visible="false" managed="false"/>
                    </HBox>
                </VBox>

                <!-- LOG pannello toggle — inizialmente nascosto -->
                <VBox fx:id="logPanel" spacing="6" styleClass="log-pane"
                      prefWidth="300" maxWidth="300"
                      visible="false" managed="false"
                      StackPane.alignment="TOP_RIGHT">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <Label text="Eventi della partita" styleClass="log-title"/>
                    <TextArea fx:id="logArea" editable="false" wrapText="true"
                              VBox.vgrow="ALWAYS" styleClass="log-area"/>
                </VBox>

                <!-- Bottone 📋 sempre visibile in alto a destra -->
                <Button fx:id="logToggleBtn" text="📋" onAction="#onToggleLog"
                        styleClass="log-toggle-btn"
                        StackPane.alignment="TOP_RIGHT">
                    <StackPane.margin><Insets top="6" right="6"/></StackPane.margin>
                </Button>
            </StackPane>
        </center>

        <!-- BOTTOM -->
        <bottom>
            <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" styleClass="players-scroll">
                <StackPane styleClass="players-bar">
                    <padding><Insets top="10" right="14" bottom="10" left="14"/></padding>
                    <HBox fx:id="playersBox" spacing="14" alignment="CENTER_LEFT"/>
                </StackPane>
            </ScrollPane>
        </bottom>
    </BorderPane>

    <!-- EVENT OVERLAY: fullscreen, initially hidden -->
    <StackPane fx:id="eventOverlay" styleClass="event-overlay"
               visible="false" mouseTransparent="true">
        <VBox fx:id="eventOverlayBox" alignment="CENTER" spacing="16" styleClass="event-overlay-box">
            <Label fx:id="eventOverlayTitle" styleClass="event-overlay-title" text=""/>
            <!-- FIX 5: carte evento in grande, affiancate se sono 2 -->
            <HBox fx:id="eventCardBox" alignment="CENTER" spacing="20" visible="false" managed="false">
                <ImageView fx:id="eventCardImageView" styleClass="event-card-image"
                           fitWidth="180" fitHeight="252" preserveRatio="true" smooth="true"
                           visible="false" managed="false"/>
                <ImageView fx:id="eventCardImageView2" styleClass="event-card-image"
                           fitWidth="180" fitHeight="252" preserveRatio="true" smooth="true"
                           visible="false" managed="false"/>
            </HBox>
            <Label fx:id="eventOverlayName"  styleClass="event-overlay-name"  text=""/>
        </VBox>
    </StackPane>

    <!-- WAITING COVER: shown until ROUND_STARTED, then hidden -->
    <StackPane fx:id="boardWaitingPane" styleClass="waiting-pane">
        <ImageView preserveRatio="true" fitWidth="1280" fitHeight="800"
                   styleClass="waiting-cover">
            <image><Image url="@/it/polimi/it/view/gui/mesos_cover.png"/></image>
        </ImageView>
        <Region styleClass="waiting-gradient" StackPane.alignment="BOTTOM_CENTER"
                prefHeight="260" maxWidth="1280"/>
        <VBox alignment="BOTTOM_CENTER" spacing="12" StackPane.alignment="BOTTOM_CENTER">
            <padding><Insets bottom="50"/></padding>
            <Label fx:id="boardWaitingTitle" text="In attesa degli altri giocatori…"
                   styleClass="waiting-title"/>
            <Label fx:id="boardWaitingPlayers" text="" styleClass="waiting-players"/>
            <ProgressIndicator styleClass="waiting-spinner" prefWidth="40" prefHeight="40"/>
        </VBox>
    </StackPane>

</StackPane>